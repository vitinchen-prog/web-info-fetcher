{
  "name": "web-info-fetcher",
  "version": "1.0.0",
  "description": "A weekly AI report generator that scans required sources, drafts Markdown reports, and can email them.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "demo": "node src/index.js https://example.com",
    "browser:login": "node src/browser-login.js",
    "collect:browser": "node src/collect-browser.js",
    "check:sources": "node src/check-sources.js",
    "report": "node src/generate-report.js",
    "send": "node src/send-email.js",
    "test": "node --test"
  },
  "keywords": [
    "web",
    "metadata",
    "fetch",
    "cli",
    "ai-news",
    "weekly-report"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "nodemailer": "^8.0.5",
    "playwright-core": "^1.59.1"
  }
}
